# Compass Energie · Führungs-Dashboard
# Lokal: als .env.local kopieren (oder `vercel env pull .env.local`). In Vercel als Environment Variables anlegen.

# --- Supabase (setzt die Vercel-Supabase-Integration automatisch) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Öffentliche Adresse (für Einladungs-Links), z. B. https://dashboard.compass-energie.de
NEXT_PUBLIC_SITE_URL=

# --- Close CRM ---
CLOSE_API_KEY=
# Ausgabe von `npm run close:webhook -- https://<domain>/api/webhooks/close`
CLOSE_WEBHOOK_SECRET=

# --- Meta Marketing API (System-User-Token, läuft nicht ab) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_API_VERSION=v23.0
# Conversions API (Rückspielung Close → Meta)
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Betrieb ---
# Zufälliger String; Vercel Cron sendet ihn als Authorization: Bearer …
CRON_SECRET=
# Slack Incoming Webhook für Briefings
SLACK_WEBHOOK_URL=

# --- Schalter (Standard: AUS) ---
# 1 = Ereignisse an Meta zurückspielen
CAPI_AKTIV=0
# 1 = Morgen-Briefing/Wochenreport wirklich an Slack senden (sonst nur Vorschau)
REPORTS_AKTIV=0
# 1 = immer Demo-Daten, 0 = nie Demo-Daten (auch wenn die DB leer ist), leer = Demo nur bei leerer DB
DEMO_DATEN=
